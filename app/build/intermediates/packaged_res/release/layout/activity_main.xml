<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark">

    <!-- =========================================================== -->
    <!--  FLOATING TOP BAR — Address Bar + SSL + Search + Menu       -->
    <!-- =========================================================== -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:elevation="4dp">

        <!-- Premium Pill Address Bar -->
        <LinearLayout
            android:id="@+id/top_bar_card"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:elevation="3dp">

            <!-- SSL Lock / Security Icon -->
            <ImageView
                android:id="@+id/btn_ssl_lock"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/colorAccent"
                android:contentDescription="Security Status"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- URL Edit Text -->
            <EditText
                android:id="@+id/edit_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@null"
                android:hint="@string/search_or_type_url"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="textUri|textNoSuggestions"
                android:maxLines="1"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textHint"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:ellipsize="end"
                android:selectAllOnFocus="true" />

            <!-- Clear URL Text Button -->
            <ImageView
                android:id="@+id/btn_clear_url"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="7dp"
                android:src="@drawable/ic_clear"
                android:tint="@color/textHint"
                android:visibility="gone"
                android:contentDescription="Clear text"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Go / Search Button -->
            <ImageButton
                android:id="@+id/btn_go"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                android:tint="@color/colorAccent"
                android:contentDescription="@string/go"
                android:padding="8dp" />

            <!-- Menu / Overflow Button -->
            <ImageButton
                android:id="@+id/btn_overflow"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:tint="@color/iconTint"
                android:contentDescription="@string/settings"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Slim Page Loading Progress Bar (3dp, brand blue) -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_drawable"
            android:visibility="gone" />

    </LinearLayout>

    <!-- =========================================================== -->
    <!--  MAIN CONTENT AREA — WebView + Home Screen                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar_container"
        android:layout_above="@+id/bottom_bar_container">

        <!-- Swipe Refresh + WebView Layout -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Native Homepage Layout (included) -->
        <include
            android:id="@+id/home_screen_layout"
            layout="@layout/layout_home_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- =========================================================== -->
    <!--  FULLSCREEN VIDEO CONTAINER                                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- =========================================================== -->
    <!--  FLOATING BOTTOM NAVIGATION BAR                             -->
    <!-- =========================================================== -->
    <LinearLayout
        android:id="@+id/bottom_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:elevation="4dp">

        <!-- Premium Pill Navigation Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar_card"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:elevation="3dp">

            <!-- Back Navigation -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:tint="@color/iconTint"
                android:contentDescription="@string/back"
                android:padding="14dp" />

            <!-- Forward Navigation -->
            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                android:tint="@color/iconTint"
                android:contentDescription="@string/forward"
                android:padding="14dp" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:tint="@color/iconTint"
                android:contentDescription="@string/refresh"
                android:padding="14dp" />

            <!-- Home Button -->
            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                android:tint="@color/iconTint"
                android:contentDescription="@string/home"
                android:padding="14dp" />

            <!-- Tabs Switcher with Count Badge -->
            <FrameLayout
                android:id="@+id/btn_tabs_layout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tabs"
                    android:tint="@color/iconTint"
                    android:contentDescription="@string/tabs" />

                <!-- Tab Count Badge -->
                <TextView
                    android:id="@+id/txt_tab_count"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textColor="@color/iconTint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
