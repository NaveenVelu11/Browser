<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark">

    <!-- =========================================================== -->
    <!--  MAIN CONTENT AREA — WebView + Home Screen                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Swipe Refresh + WebView Layout -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Native Homepage Layout -->
        <include
            android:id="@+id/home_screen_layout"
            layout="@layout/layout_home_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Media Download Detection Sniffer Bar -->
        <LinearLayout
            android:id="@+id/card_media_detected"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:elevation="6dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_download"
                android:tint="@color/colorAccent"
                android:contentDescription="Media detected" />

            <TextView
                android:id="@+id/txt_media_detected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Downloadable Media Detected"
                android:textColor="@color/textPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </FrameLayout>

    <!-- =========================================================== -->
    <!--  FULLSCREEN VIDEO CONTAINER                                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- =========================================================== -->
    <!--  UNIFIED FLOATING TOP NAVIGATION BAR (All Controls)         -->
    <!-- =========================================================== -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:elevation="8dp">

        <!-- Master Integrated Control Toolbar -->
        <LinearLayout
            android:id="@+id/top_bar_card"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_toolbar_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:elevation="4dp">

            <!-- Home Button -->
            <ImageButton
                android:id="@+id/btn_home"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_home"
                android:tint="@color/iconTint"
                android:contentDescription="@string/home"
                android:padding="6dp" />

            <!-- Back Navigation Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:tint="@color/iconTint"
                android:contentDescription="@string/back"
                android:padding="6dp" />

            <!-- Forward Navigation Button -->
            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                android:tint="@color/iconTint"
                android:contentDescription="@string/forward"
                android:padding="6dp" />

            <!-- Pill Address Bar Area -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_home_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- SSL Lock / Security Status -->
                <ImageView
                    android:id="@+id/btn_ssl_lock"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/colorAccent"
                    android:contentDescription="Security Status"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Address Input -->
                <EditText
                    android:id="@+id/edit_url"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_or_type_url"
                    android:imeOptions="actionGo|flagNoExtractUi"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textHint"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:ellipsize="end"
                    android:selectAllOnFocus="true" />

                <!-- Clear Text Button -->
                <ImageView
                    android:id="@+id/btn_clear_url"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:padding="5dp"
                    android:src="@drawable/ic_clear"
                    android:tint="@color/textHint"
                    android:visibility="gone"
                    android:contentDescription="Clear"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Go / Search Button -->
                <ImageButton
                    android:id="@+id/btn_go"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    android:tint="@color/colorAccent"
                    android:contentDescription="@string/go"
                    android:padding="5dp" />
            </LinearLayout>

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                android:tint="@color/iconTint"
                android:contentDescription="@string/refresh"
                android:padding="6dp" />

            <!-- Tabs Button with Count Badge -->
            <FrameLayout
                android:id="@+id/btn_tabs_layout"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tabs"
                    android:tint="@color/iconTint"
                    android:contentDescription="@string/tabs" />

                <!-- Tab Count Badge -->
                <TextView
                    android:id="@+id/txt_tab_count"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textColor="@color/iconTint"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </FrameLayout>

            <!-- Overflow / Menu Button -->
            <ImageButton
                android:id="@+id/btn_overflow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:tint="@color/iconTint"
                android:contentDescription="@string/settings"
                android:padding="6dp" />

        </LinearLayout>

        <!-- Slim Page Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_drawable"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
