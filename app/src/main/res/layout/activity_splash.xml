<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:gravity="center">

    <!-- Animated gradient background overlay -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:background="@drawable/bg_splash_glow" />

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo with shadow container -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_splash_logo"
            android:gravity="center">

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_deerone_logo"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DeerOne"
            android:textColor="@color/splash_text_primary"
            android:textSize="34sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Fast · Private · Modern"
            android:textColor="@color/splash_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04" />

    </LinearLayout>

    <!-- Bottom progress indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="52dp"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/splash_progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/colorAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Starting up..."
            android:textColor="@color/splash_text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.03" />

    </LinearLayout>

</RelativeLayout>
