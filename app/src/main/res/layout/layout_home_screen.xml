<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nested_scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="80dp"
        android:paddingEnd="20dp"
        android:paddingBottom="48dp">

        <!-- ================================================ -->
        <!--  HERO LOGO + GREETING SECTION                    -->
        <!-- ================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- App Icon with gradient background -->
            <LinearLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_splash_logo"
                android:gravity="center"
                android:elevation="6dp">

                <ImageView
                    android:id="@+id/img_home_logo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_deerone_logo"
                    android:contentDescription="@string/app_name" />
            </LinearLayout>

            <!-- Brand name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="DeerOne"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <!-- Subtext -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fast · Private · Minimalist"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.01" />

        </LinearLayout>

        <!-- ================================================ -->
        <!--  FLOATING SEARCH PILL (Main CTA)                 -->
        <!-- ================================================ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_home_search"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <!-- Search icon -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search_icon"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/search" />
                </LinearLayout>

                <!-- Hint text -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/search_or_type_url"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />

                <!-- Mic button -->
                <ImageView
                    android:id="@+id/btn_home_voice"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_reader"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="Voice Search"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================================================ -->
        <!--  QUICK ACCESS ROW (4 icon shortcut pills)        -->
        <!-- ================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Bookmarks shortcut -->
            <LinearLayout
                android:id="@+id/shortcut_bookmarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_shortcut_blue"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_bookmark"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/bookmarks" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Bookmarks"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- History shortcut -->
            <LinearLayout
                android:id="@+id/shortcut_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_shortcut_orange"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_history"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/history" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="History"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Downloads shortcut -->
            <LinearLayout
                android:id="@+id/shortcut_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_shortcut_green"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_download"
                        app:tint="#FFFFFF"
                        android:contentDescription="Downloads" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Downloads"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Settings shortcut -->
            <LinearLayout
                android:id="@+id/shortcut_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_shortcut_gray"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_settings"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/settings" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Settings"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

        </LinearLayout>

        <!-- ================================================ -->
        <!--  QUICK SHORTCUTS SECTION HEADER                  -->
        <!-- ================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_section_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quick Shortcuts"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_add_custom_shortcut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add"
                android:textColor="?attr/colorAccentiOS"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Custom Shortcuts Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_custom_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <!-- ================================================ -->
        <!--  RECENTLY VISITED SECTION HEADER                 -->
        <!-- ================================================ -->
        <LinearLayout
            android:id="@+id/section_recent_visited"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_section_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recently Visited"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent history card list -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_recent_visited"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </androidx.cardview.widget.CardView>

        <!-- Empty state (clean start) -->
        <LinearLayout
            android:id="@+id/layout_home_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:background="@drawable/bg_empty_state"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_shortcut_blue"
                android:gravity="center">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_shield"
                    app:tint="#FFFFFF"
                    android:contentDescription="Clean web state" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Your Clean Web Space"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Type a URL above or add shortcuts to get started."
                android:textColor="?attr/colorTextSecondary"
                android:textSize="13sp"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
