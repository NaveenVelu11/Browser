<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nested_scroll_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- ======================================== -->
        <!--  LOGO + BRAND BLOCK (ultra compact)      -->
        <!-- ======================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="28dp">

            <!-- Flat app icon badge -->
            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_splash_logo"
                android:gravity="center">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_home_logo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_deerone_logo"
                    android:contentDescription="@string/app_name" />
            </LinearLayout>

            <!-- Brand name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="DeerOne"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ======================================== -->
        <!--  SEARCH PILL                             -->
        <!-- ======================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_home_search"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="16dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_search"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="@string/search" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/search_or_type_url"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_home_voice"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="8dp"
                    app:srcCompat="@drawable/ic_reader"
                    app:tint="?attr/colorTextSecondary"
                    android:contentDescription="Voice Search"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ======================================== -->
        <!--  QUICK ACCESS — 4 icon row               -->
        <!-- ======================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Bookmarks -->
            <LinearLayout
                android:id="@+id/shortcut_bookmarks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_shortcut_blue"
                    android:gravity="center">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        app:srcCompat="@drawable/ic_bookmark"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/bookmarks" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Bookmarks"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:id="@+id/shortcut_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_shortcut_orange"
                    android:gravity="center">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        app:srcCompat="@drawable/ic_history"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/history" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="History"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Downloads -->
            <LinearLayout
                android:id="@+id/shortcut_downloads"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_shortcut_green"
                    android:gravity="center">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        app:srcCompat="@drawable/ic_download"
                        app:tint="#FFFFFF"
                        android:contentDescription="Downloads" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Downloads"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/shortcut_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_shortcut_gray"
                    android:gravity="center">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        app:srcCompat="@drawable/ic_settings"
                        app:tint="#FFFFFF"
                        android:contentDescription="@string/settings" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Settings"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>

        <!-- ======================================== -->
        <!--  QUICK SHORTCUTS SECTION                 -->
        <!-- ======================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quick Shortcuts"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/btn_add_custom_shortcut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add"
                android:textColor="?attr/colorAccentiOS"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Custom Shortcuts Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_custom_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false" />

        <!-- Empty state — shown when no history/shortcuts -->
        <LinearLayout
            android:id="@+id/layout_home_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/ic_search"
                app:tint="?attr/colorTextSecondary"
                android:alpha="0.4"
                android:contentDescription="Empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nothing here yet"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Type in the bar above to start browsing."
                android:textColor="?attr/colorTextSecondary"
                android:textSize="12sp"
                android:gravity="center"
                android:alpha="0.7" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
