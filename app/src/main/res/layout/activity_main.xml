<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceBackground">

    <!-- =========================================================== -->
    <!--  MAIN CONTENT AREA — WebView + Home Screen                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Swipe Refresh + WebView Layout -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Native Homepage Layout -->
        <include
            android:id="@+id/home_screen_layout"
            layout="@layout/layout_home_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Download Pill Action Badge [↓ Download Media] (Bottom Right) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_floating_download_badge"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="23dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="Download Media" />

                <TextView
                    android:id="@+id/txt_media_detected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Download Media"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- =========================================================== -->
    <!--  FULLSCREEN VIDEO CONTAINER                                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- =========================================================== -->
    <!--  UNCLUTTERED iOS HIG TOP ADDRESS BAR CONTAINER               -->
    <!-- =========================================================== -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:elevation="8dp">

        <!-- iOS Address Bar Layout -->
        <include
            android:id="@+id/toolbar_address_bar"
            layout="@layout/toolbar_address_bar" />

        <!-- Slim Page Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_drawable"
            android:visibility="gone" />

    </LinearLayout>

    <!-- =========================================================== -->
    <!--  FLOATING CIRCULAR HEADER TRIGGER BUTTON (<)                -->
    <!-- =========================================================== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_floating_header_trigger"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorCardBackground"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorAccentiOS"
            android:contentDescription="Expand Header Bar" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>
