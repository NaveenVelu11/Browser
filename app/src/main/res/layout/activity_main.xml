<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceBackground">

    <!-- =========================================================== -->
    <!--  MAIN CONTENT AREA — WebView + Home Screen                  -->
    <!-- =========================================================== -->
    <!-- =========================================================== -->
    <!--  UNCLUTTERED TOP ADDRESS BAR CONTAINER                       -->
    <!-- =========================================================== -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:elevation="4dp">

        <!-- Address Bar Layout -->
        <include
            android:id="@+id/toolbar_address_bar"
            layout="@layout/toolbar_address_bar" />

        <!-- Slim Page Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_drawable"
            android:visibility="gone" />

    </LinearLayout>

    <!-- =========================================================== -->
    <!--  MAIN CONTENT AREA — WebView + Home Screen                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="-56dp"
        android:paddingTop="56dp">

        <!-- Swipe Refresh + WebView Layout -->
        <FrameLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/webview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Native Homepage Layout -->
        <include
            android:id="@+id/home_screen_layout"
            layout="@layout/layout_home_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- =========================================================== -->
    <!--  FULLSCREEN VIDEO CONTAINER                                  -->
    <!-- =========================================================== -->
    <FrameLayout
        android:id="@+id/custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Hidden floating header trigger button for compatibility -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_floating_header_trigger"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Fullscreen Restore Handle -->
    <FrameLayout
        android:id="@+id/fullscreen_restore_handle"
        android:layout_width="56dp"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/shape_restore_handle_bg"
        android:visibility="gone"
        android:elevation="6dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_chevron_left"
            android:rotation="-90"
            app:tint="#FFFFFF"
            android:contentDescription="Restore Header" />

    </FrameLayout>

</RelativeLayout>
