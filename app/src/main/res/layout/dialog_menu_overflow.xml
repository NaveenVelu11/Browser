<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_md">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorCardBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Drag Handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_empty_state"
                android:alpha="0.4" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_deerone_logo"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="DeerOne" />

                <TextView
                    android:id="@+id/txt_menu_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="DeerOne Browser"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/menu_nav_back"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_back"
                    app:tint="?attr/colorTextPrimary"
                    android:contentDescription="Back" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/menu_nav_forward"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_forward"
                    app:tint="?attr/colorTextPrimary"
                    android:contentDescription="Forward" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/menu_nav_home"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_home"
                    app:tint="?attr/colorTextPrimary"
                    android:contentDescription="Home" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/menu_nav_refresh"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:srcCompat="@drawable/ic_refresh"
                    app:tint="?attr/colorTextPrimary"
                    android:contentDescription="Refresh" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/colorDivider" />

            <!-- Action Grid Row 1: New Tab, Incognito, Add Bookmark, Share -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:gravity="center">

                <!-- New Tab -->
                <LinearLayout
                    android:id="@+id/menu_action_new_tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_add"
                        app:tint="?attr/colorAccentiOS"
                        android:contentDescription="New Tab" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="New Tab"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Incognito -->
                <LinearLayout
                    android:id="@+id/menu_action_incognito"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_incognito"
                        app:tint="?attr/colorAccentiOS"
                        android:contentDescription="Incognito" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Incognito"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Add Bookmark -->
                <LinearLayout
                    android:id="@+id/menu_action_add_bookmark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_star_outline"
                        app:tint="?attr/colorAccentiOS"
                        android:contentDescription="Bookmark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Bookmark"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

                <!-- Share -->
                <LinearLayout
                    android:id="@+id/menu_action_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:srcCompat="@drawable/ic_share"
                        app:tint="?attr/colorAccentiOS"
                        android:contentDescription="Share" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Share"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="?attr/colorDivider" />

            <!-- Main Menu Item List -->
            <!-- Bookmarks -->
            <LinearLayout
                android:id="@+id/menu_action_bookmarks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_bookmark"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="@string/bookmarks" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/bookmarks"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:id="@+id/menu_action_history"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_history"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="@string/history" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/history"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Downloads -->
            <LinearLayout
                android:id="@+id/menu_action_downloads"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_download"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="Downloads" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Downloads"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

            <!-- Desktop Site Toggle -->
            <LinearLayout
                android:id="@+id/menu_action_desktop_site"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_desktop"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="Desktop Site" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Desktop Site"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_desktop_site"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Night Mode Toggle -->
            <LinearLayout
                android:id="@+id/menu_action_night_mode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_shield"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="Dark Mode" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Dark Mode"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_night_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <!-- Settings -->
            <LinearLayout
                android:id="@+id/menu_action_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    app:srcCompat="@drawable/ic_settings"
                    app:tint="?attr/colorAccentiOS"
                    android:contentDescription="@string/settings" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/settings"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
