<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top Header Navigation Toolbar (iOS / Chrome Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorCardBackground"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:elevation="2dp">

            <ImageButton
                android:id="@+id/btn_back_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="?attr/colorTextPrimary"
                android:contentDescription="@string/back" />

            <ImageButton
                android:id="@+id/btn_header_forward"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                app:tint="?attr/colorTextPrimary"
                android:alpha="0.35"
                android:enabled="false"
                android:contentDescription="@string/forward" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/settings"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btn_save_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check"
                app:tint="?attr/colorAccentiOS"
                android:contentDescription="@string/save" />
        </LinearLayout>

        <!-- Stats Overview Inset Grouped Card (Brave Shields Style) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_stat_blocked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="?attr/colorAccentiOS"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ads &amp; Trackers"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/colorDivider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_stat_saved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 MB"
                        android:textColor="@color/colorSuccess"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data Saved"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="?attr/colorDivider" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_stat_tabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tabs Opened"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: GENERAL -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GENERAL"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Homepage -->
                <LinearLayout
                    style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Homepage" />
                    <EditText
                        android:id="@+id/edit_homepage"
                        android:layout_width="160dp"
                        android:layout_height="36dp"
                        android:background="@drawable/shape_address_bar_bg"
                        android:gravity="center_vertical"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Search Engine -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Search Engine" />
                    <Spinner
                        android:id="@+id/spinner_search_engine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- User Agent -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="User Agent" />
                    <Spinner
                        android:id="@+id/spinner_user_agent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Theme -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Theme Mode" />
                    <Spinner
                        android:id="@+id/spinner_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Text Size -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Page Text Size" />
                    <Spinner
                        android:id="@+id/spinner_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: PRIVACY & SHIELDS -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRIVACY &amp; SHIELDS"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ad Blocker -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Block Ads" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_ad_block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Tracker Blocker -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Block Trackers" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_tracker_block"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- HTTPS Only -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="HTTPS-Only Mode" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_https_only"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Do Not Track -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Send Do Not Track Header" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_dnt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Block Popups -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Block Popups" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_block_popups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Safe Browsing -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Safe Browsing Protection" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_safe_browsing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <!-- Cookie Policy -->
                <LinearLayout style="@style/SettingsRowStyle">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cookie Acceptance" />
                    <Spinner
                        android:id="@+id/spinner_cookies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECTION: DATA MANAGEMENT -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DATA &amp; STORAGE"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorCardBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/btn_clear_cache"
                    style="@style/SettingsRowStyle"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear Cache" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <LinearLayout
                    android:id="@+id/btn_clear_cookies"
                    style="@style/SettingsRowStyle"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear Cookies" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/colorDivider" />

                <LinearLayout
                    android:id="@+id/btn_clear_storage"
                    style="@style/SettingsRowStyle"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        style="@style/TextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Clear All Browsing Data"
                        android:textColor="@color/colorError" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        app:tint="@color/colorError" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
