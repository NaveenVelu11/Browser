<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundDark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surfaceDark"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_back_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/settings"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- General Settings Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="General Settings"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Homepage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surfaceDark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/homepage_setting"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edit_homepage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/search_bar_bg"
                android:hint="https://www.google.com"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textHint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Default Search Engine -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@color/surfaceDark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_engine_setting"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spinner_search_engine"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- User Agent Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@color/surfaceDark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/user_agent_setting"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spinner_user_agent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Security & Privacy Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Security &amp; Privacy"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_ad_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surfaceDark"
            android:padding="16dp"
            android:text="Ad &amp; Tracker Blocker"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_https_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@color/surfaceDark"
            android:padding="16dp"
            android:text="HTTPS-Only Mode"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_session_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@color/surfaceDark"
            android:padding="16dp"
            android:text="Session Restore on Launch"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_autofill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:background="@color/surfaceDark"
            android:padding="16dp"
            android:text="Password &amp; Form Autofill"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <!-- Privacy & Clear Data Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Clear Data"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp"
            android:backgroundTint="@color/surfaceDark"
            android:text="@string/clear_cache"
            android:textColor="@color/textPrimary" />

        <Button
            android:id="@+id/btn_clear_cookies"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp"
            android:backgroundTint="@color/surfaceDark"
            android:text="@string/clear_cookies"
            android:textColor="@color/textPrimary" />

        <Button
            android:id="@+id/btn_clear_storage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="4dp"
            android:backgroundTint="@color/surfaceDark"
            android:text="@string/clear_storage"
            android:textColor="@color/textPrimary" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="16dp"
            android:backgroundTint="@color/colorAccent"
            android:text="Save Settings"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
