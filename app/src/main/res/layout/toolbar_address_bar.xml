<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/address_bar_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/colorSurfaceBackground"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <!-- Pill Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:background="@drawable/shape_address_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- SSL Lock / Security Status Icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_ssl_lock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:padding="3dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_lock"
            app:tint="?attr/colorTextSecondary" />

        <!-- URL Edit Text -->
        <EditText
            android:id="@+id/edit_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:hint="@string/search_or_type_url"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:selectAllOnFocus="true"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextSecondary"
            android:textSize="14sp" />

        <!-- Clear URL Button -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_clear_url"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear Text"
            android:padding="6dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_clear"
            app:tint="?attr/colorTextSecondary" />

        <!-- Refresh / Reload Button -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload Page"
            android:padding="6dp"
            app:srcCompat="@drawable/ic_refresh"
            app:tint="?attr/colorTextSecondary" />

    </LinearLayout>

    <!-- Hidden Collapse Header button for backwards compatibility -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_collapse_header"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Tabs Switcher Button -->
    <FrameLayout
        android:id="@+id/btn_tabs_layout"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/ic_tabs"
            app:tint="?attr/colorTextPrimary"
            android:contentDescription="Tabs" />

        <TextView
            android:id="@+id/txt_tab_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:text="1"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Overflow / 3 Dots Menu -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_overflow"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_menu"
        app:tint="?attr/colorTextPrimary" />

</LinearLayout>
