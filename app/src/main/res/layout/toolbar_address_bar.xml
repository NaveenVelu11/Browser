<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/address_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="?attr/colorSurfaceBackground"
    android:elevation="4dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Translucent Capsule Container (Domain & Search Display) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pill_url_container"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/shape_address_bar_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_collapse_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- SSL Lock / Security Status Indicator -->
        <ImageView
            android:id="@+id/btn_ssl_lock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Security Status"
            android:padding="10dp"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorAccentiOS"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Domain / URL Text Input -->
        <EditText
            android:id="@+id/edit_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:hint="@string/search_or_type_url"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextSecondary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_ssl_lock"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtle Collapse Header Button -->
    <ImageButton
        android:id="@+id/btn_collapse_header"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Collapse Header"
        android:padding="10dp"
        android:src="@drawable/ic_clear"
        app:tint="?attr/colorTextSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_overflow"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Unified Overflow Menu Button -->
    <ImageButton
        android:id="@+id/btn_overflow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="10dp"
        android:src="@drawable/ic_menu"
        app:tint="?attr/colorTextPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
