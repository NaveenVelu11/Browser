<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/address_bar_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/colorSurfaceBackground"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- SSL Lock / Security Status Icon -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_ssl_lock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Security Status"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_lock"
        app:tint="?attr/colorAccentiOS" />

    <!-- URL Edit Text — takes all remaining horizontal space -->
    <EditText
        android:id="@+id/edit_url"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/shape_address_bar_bg"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:hint="@string/search_or_type_url"
        android:imeOptions="actionGo|flagNoExtractUi"
        android:inputType="textUri|textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:selectAllOnFocus="true"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        android:textSize="14sp" />

    <!-- Clear URL Button -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_clear_url"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Clear Text"
        android:padding="10dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_clear"
        app:tint="?attr/colorTextSecondary" />

    <!-- Collapse / Hide Header -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_collapse_header"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Collapse Header"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_clear"
        app:tint="?attr/colorTextSecondary" />

    <!-- Overflow / More Menu -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_overflow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_menu"
        app:tint="?attr/colorTextPrimary" />

</LinearLayout>
