<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSurfaceBackground">@color/ios_surface_light</item>
        <item name="colorCardBackground">@color/ios_card_light</item>
        <item name="colorTextPrimary">@color/ios_text_primary_light</item>
        <item name="colorTextSecondary">@color/ios_text_secondary_light</item>
        <item name="colorAccentiOS">@color/ios_accent_light</item>
        <item name="colorDivider">@color/ios_divider_light</item>
        <item name="android:windowBackground">@color/ios_surface_light</item>
        <item name="android:textColorPrimary">@color/ios_text_primary_light</item>
        <item name="android:windowAnimationStyle">@style/ActivityTransition</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccentiOS</item>
        <item name="colorSurfaceBackground">@color/incognitoBackground</item>
        <item name="colorCardBackground">@color/incognitoSurface</item>
        <item name="colorTextPrimary">@color/incognitoText</item>
        <item name="colorTextSecondary">#B0BEC5</item>
        <item name="colorAccentiOS">@color/incognito_accent</item>
        <item name="colorDivider">#37474F</item>
        <item name="android:windowBackground">@color/incognitoBackground</item>
        <item name="android:textColorPrimary">@color/incognitoText</item>
        <item name="android:windowAnimationStyle">@style/ActivityTransition</item>
    </style>

    <style name="ActivityTransition">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorAccentiOS</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="SettingsRowStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
    </style>
</resources>