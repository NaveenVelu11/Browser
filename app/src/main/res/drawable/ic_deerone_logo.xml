<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:layout_width="128dp"
    android:height="128dp"
    android:layout_height="128dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer Rounded Glass Badge -->
    <path
        android:pathData="M20,10 L80,10 A10,10 0 0,1 90,20 L90,80 A10,10 0 0,1 80,90 L20,90 A10,10 0 0,1 10,80 L10,20 A10,10 0 0,1 20,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:color="#2563EB" android:offset="0.0" />
                <item android:color="#1D4ED8" android:offset="0.5" />
                <item android:color="#0F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Accent Inner Ring -->
    <path
        android:pathData="M22,12 L78,12 A8,8 0 0,1 86,20 L86,78 A8,8 0 0,1 78,86 L22,86 A8,8 0 0,1 14,78 L14,20 A8,8 0 0,1 22,12 Z"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:color="#60A5FA" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deer Antlers Left -->
    <path
        android:pathData="M 38,45 C 32,38 25,32 24,25 C 28,28 32,32 36,38 C 34,30 30,22 28,18 C 34,24 38,32 40,40 Z"
        android:fillColor="#FFFFFF" />

    <!-- Deer Antlers Right -->
    <path
        android:pathData="M 62,45 C 68,38 75,32 76,25 C 72,28 68,32 64,38 C 66,30 70,22 72,18 C 66,24 62,32 60,40 Z"
        android:fillColor="#FFFFFF" />

    <!-- Deer Face & Ears -->
    <path
        android:pathData="M 50,75 L 36,46 C 34,42 42,44 50,47 C 58,44 66,42 64,46 Z"
        android:fillColor="#FFFFFF" />

    <!-- Sleek Crown Accent -->
    <path
        android:pathData="M 50,30 L 53,38 L 47,38 Z"
        android:fillColor="#60A5FA" />

    <!-- Nose Accent -->
    <path
        android:pathData="M 50,72 A 2,2 0 1,1 50,76 A 2,2 0 1,1 50,72 Z"
        android:fillColor="#2563EB" />

</vector>
